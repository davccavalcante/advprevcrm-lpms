# Advprev CRM, environment variables
# This file documents every variable the project needs, with purpose and provenance, and carries no values (mandatory standard 7 of PREAMBLE.md).
# Copy to .env and fill the values. Never commit .env. When creating a new variable, document it here first.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# Environment selector: development, staging, or production. Each environment has its own database and keys.
APP_ENV=
# Public base URL of the application. Development: http://localhost:3000. Production: the Hostinger VPS URL behind Nginx.
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------
# Supabase, database, auth, file storage, row level security (Brazil region unless ordered otherwise)
# Obtain all of these at supabase.com, your project, Project Settings, API and Database sections.
# ------------------------------------------------------------------
# Project URL (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe for the browser because access rules are enforced in the database by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server only, bypasses RLS. Never expose to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Project Settings, Database, Connection string). Used by migrations and the durable-execution store (@takk/alkaline Postgres cell).
SUPABASE_DB_URL=
# Project reference id, the subdomain of the project URL. Used by the Supabase CLI and scripts.
SUPABASE_PROJECT_REF=

# ------------------------------------------------------------------
# Anthropic API, the reasoning substrate of the Massive Intelligence (IM) layer
# Obtain at console.anthropic.com, API Keys. The model is a configuration decision, never a structural dependency.
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional comma-separated key pool for @takk/keymesh rotation, failover, and rate-limit recovery. Empty means the single key above is used.
ANTHROPIC_API_KEYS=
# Model id used by the IM layer. Provisioned by the director; the merge preserves the value already present in .env.
ANTHROPIC_MODEL=
# Optional fallback model id for @takk/modelchain and @takk/caduceus routing when the primary is unavailable or over budget.
ANTHROPIC_MODEL_FALLBACK=
# Per-call output token cap enforced by the internal abstraction.
ANTHROPIC_MAX_OUTPUT_TOKENS=

# ------------------------------------------------------------------
# Google Gemini API, the default reasoning provider of the IM layer
# Obtain at aistudio.google.com, API Keys. By the director's decision of
# 2026-08-18, Gemini answers by default and Claude takes over automatically
# when no Gemini key works.
# ------------------------------------------------------------------
GEMINI_API_KEY=
# Optional comma-separated key pool for @takk/keymesh rotation, failover, and rate-limit recovery. Empty means the single key above is used.
GEMINI_API_KEYS=
# Model id used by the IM layer. Empty falls back to the default measured live against the service.
GEMINI_MODEL=
# Optional fallback model id for future routing use.
GEMINI_MODEL_FALLBACK=
# Per-call output token cap for Gemini calls. Empty inherits the Anthropic cap
# raised to a measured floor of 2048, because the default Gemini model spends
# reasoning tokens inside the same cap and a lower cap truncates the answer
# (measured 2026-08-21). A value set here replaces the floor entirely.
GEMINI_MAX_OUTPUT_TOKENS=

# ------------------------------------------------------------------
# Real-time search integrated with the IM layer
# ------------------------------------------------------------------
# Exa search API key. Obtain at dashboard.exa.ai, API Keys.
EXA_API_KEY=
# Optional comma-separated Exa key pool for @takk/keymesh.
EXA_API_KEYS=
# Tavily search API key. Obtain at app.tavily.com, API Keys.
TAVILY_API_KEY=
# Optional comma-separated Tavily key pool for @takk/keymesh.
TAVILY_API_KEYS=

# ------------------------------------------------------------------
# TeleologyHI IM governance layer (MAIC, HIM, NHE)
# ------------------------------------------------------------------
# Filesystem directory of the MAIC store: axioms, registered HIMs, interactions, audit chain (append-only NDJSON with SHA-256 chain). Keep outside version control.
TELEOLOGYHI_STORE_DIR=
# Path to the Creator Ed25519 keyring PEM (CreatorKeyring.saveTo). Generated once by the director; whoever holds it has root authority over MAIC axioms. Never commit.
TELEOLOGYHI_CREATOR_KEY_PATH=
# Identifier of the HIM spirit bound to this deployment, issued at the birth event (createHim).
TELEOLOGYHI_HIM_ID=
# Future remote MAIC endpoint for the thin-client architecture (https://teleologyhi.com). Empty while MAIC runs locally.
TELEOLOGYHI_REMOTE_MAIC_URL=

# ------------------------------------------------------------------
# IM cost governance (@takk/treasury, @takk/tokenforecast); hard USD ceilings with depletion events
# ------------------------------------------------------------------
IM_BUDGET_PER_REQUEST_USD=
IM_BUDGET_PER_TASK_USD=
IM_BUDGET_PER_DAY_USD=

# ------------------------------------------------------------------
# Official judicial integrations
# ------------------------------------------------------------------
# Public API key issued by the CNJ for DataJud. Obtain at https://datajud-wiki.cnj.jus.br/api-publica/acesso. Tracking source only, never a deadline source.
DATAJUD_API_KEY=
# DataJud base URL. Each court has its own endpoint; this is the gateway base documented in the CNJ wiki.
DATAJUD_BASE_URL=
# DJEN, official source of publications and service notices: https://comunica.pje.jus.br/api. No key required today; queried by OAB registration, state, and case number. Deadlines are born here.
DJEN_BASE_URL=

# ------------------------------------------------------------------
# Observability, Sentry (@sentry/nextjs), personal data scrubbed before sending
# Obtain at sentry.io, Project Settings, Client Keys (DSN) and Settings, Auth Tokens.
# ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source map upload in CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=

# ------------------------------------------------------------------
# Alert channels for drift and integration health (@takk/behavioralai, @takk/glasshouse). All optional.
# ------------------------------------------------------------------
# Slack incoming webhook. Obtain: Slack workspace, app, Incoming Webhooks.
SLACK_WEBHOOK_URL=
# Generic webhook receiver for alerts.
ALERT_WEBHOOK_URL=
# Telegram bot token, from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# PagerDuty Events API v2 routing key.
PAGERDUTY_ROUTING_KEY=

# ------------------------------------------------------------------
# Scheduled jobs and security
# ------------------------------------------------------------------
# Shared secret protecting scheduled-job endpoints (DataJud and DJEN capture). Generate: openssl rand -hex 32.
CRON_SECRET=
# HMAC secret for single-use, expiring secure document upload links (pending director decision, INFO.md 14.1). Generate: openssl rand -hex 32.
SECURE_UPLOAD_LINK_SECRET=
# Validity window of upload links, in hours.
SECURE_UPLOAD_LINK_TTL_HOURS=
# Application-level field encryption key for data at rest beyond database encryption. Generate: openssl rand -hex 32.
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Email intake and outbound (INFO.md section 6.1; channel pending director decision 14.1)
# Obtain from the firm's email provider (IMAP and SMTP settings).
# ------------------------------------------------------------------
EMAIL_INTAKE_IMAP_HOST=
EMAIL_INTAKE_IMAP_PORT=
EMAIL_INTAKE_IMAP_USER=
EMAIL_INTAKE_IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address for outbound messages approved by a lawyer.
SMTP_FROM=

# ------------------------------------------------------------------
# Optional telemetry and family serve bridges
# ------------------------------------------------------------------
# OpenTelemetry collector endpoint for @takk/glasshouse and @teleologyhi-sdk/nhe traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bearer tokens, only if the respective serve bridges are enabled. Generate: openssl rand -hex 32.
GAPTIME_TOKEN=
RACS_TOKEN=
KRIKOS_TOKEN=

# ------------------------------------------------------------------
# Local document reading (poppler + tesseract, on this machine)
# ------------------------------------------------------------------
# Tesseract language pack used for optical reading. Default: por.
OCR_LANGUAGE=
# Mean confidence, zero to one hundred, at or above which a document is processed. Default: 80, measured on the office corpus.
OCR_CONFIDENCE_PROCESSED=
# Mean confidence below which a document is failed; between the two it is pending human validation. Default: 55.
OCR_CONFIDENCE_REVIEW=

# ------------------------------------------------------------------
# Cost control of the reasoning layer
# ------------------------------------------------------------------
# Tokens, input plus output, a single conversation may consume before the office
# stops sending it to the model. Default: 120000.
IM_CONVERSATION_TOKEN_CEILING=
# Tokens, input plus output, the whole office may consume in one day, closed in
# the office time zone. Default: 600000.
IM_DAILY_TOKEN_CEILING=
# Minutes an answer stays reusable. The key already carries the records that
# produced it, so only the clock moves inside this window. Default: 30.
IM_CACHE_TTL_MINUTES=
# Price of the model per million tokens, input and output, in the currency
# below. Both are needed; absent either one, the office reports consumption in
# tokens and never estimates money.
IM_PRICE_INPUT_PER_MTOK=
IM_PRICE_OUTPUT_PER_MTOK=
# Same pair for the Gemini models; without them, Gemini consumption is
# reported in tokens and never estimated in money.
IM_PRICE_GEMINI_INPUT_PER_MTOK=
IM_PRICE_GEMINI_OUTPUT_PER_MTOK=
# Currency code of the two prices above. Default: USD.
IM_PRICE_CURRENCY=
# Optional money ceilings, per conversation and per day, in the same currency.
# They only take effect when the price above is configured.
IM_CONVERSATION_SPEND_CEILING=
IM_DAILY_SPEND_CEILING=

# ------------------------------------------------------------------
# Capture of publications and of procedural metadata
# ------------------------------------------------------------------
# Registration of the Order of Attorneys the office watches at the DJEN. The
# number carries digits only and the unit carries the two letters.
MONITORED_OAB_NUMBER=
MONITORED_OAB_UF=
# Other registrations to watch, separated by commas, each one written as the
# unit followed by the number, for example SP530198. Empty in this phase.
MONITORED_OAB_ADDITIONAL=
# How many days of availability a scheduled run asks for. The window overlaps
# the previous run on purpose, and the fingerprint of each act prevents a second
# record. Default: 7.
DJEN_CAPTURE_WINDOW_DAYS=
# How long a source may go without a successful capture before the health panel
# reports it as late, in hours. Default: 30.
CAPTURE_STALE_AFTER_HOURS=
# Business days of margin between the internal deadline of a task and the legal
# deadline of the act. Default: 2.
TASK_INTERNAL_MARGIN_BUSINESS_DAYS=

# ------------------------------------------------------------------
# Network egress of the capture
# ------------------------------------------------------------------
# Every call to the DJEN and to the DataJud is made by the server, never by the
# browser of a lawyer, so where the lawyer is has no effect on anything.
#
# In production this variable does not exist and the egress is direct, because
# the server of the office is in Brazil. The code ignores it when NODE_ENV is
# production, so a value left behind can never reroute the traffic of the office.
#
# In development, when the machine of the developer is outside Brazil and the
# distribution of the DJEN refuses it by country, the egress may go through a
# tunnel the office opens against its own server, with the dynamic port
# forwarding of SSH. No paid network, no third party proxy and no external
# service. With the tunnel closed the call fails and says so; nothing is ever
# simulated. Example: socks5://127.0.0.1:1080
CAPTURE_SOCKS_PROXY=
