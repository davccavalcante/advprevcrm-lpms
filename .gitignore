# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files, .env.example is the only committed one
.env*
!.env.example

# state data (local IM stores, audit chains, keyrings)
/teleologyhi-store/
/maic-store/

# internal documents
.creator
.env.backup-*

# The method law and the working memory of this office. By the director's order
# of 2026-09-01 these never reach the public repository: the preamble carries
# the server, the monitored registration and the operating rules; the handoff
# carries the measured state of the office; the agent files carry the playbook;
# and .claude carries the operational rules and the local settings.
/.claude/
/PREAMBLE.md
/HANDOFF.md
/AGENTS.md
/CLAUDE.md

# Personal and sensitive personal data. assets/ holds real client documents used
# to exercise the upload interface, including identity, employment and health
# records; data/ holds everything the application writes about a client and a
# case. Neither ever reaches the repository.
/assets/
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
